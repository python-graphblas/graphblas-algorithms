[flake8]
max-line-length = 100
inline-quotes = "
exclude =
    graphblas_algorithms/*/tests/,
    graphblas_algorithms/*/*/tests/,
    build/
# E203 for black; B042 because ArpackNoConvergence mirrors SciPy's signature.
extend-ignore =
    E203,
    SIM105,
    SIM401,
    B042,
# No trailing comments below: flake8 would read them as part of the pattern.
per-file-ignores =
    __init__.py:F401,F403
    _nx_graphblas/__init__.py:E501
    graphblas_algorithms/nxapi/exception.py:F401
